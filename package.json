{
  "name": "vscode-component-preview",
  "displayName": "React Component Preview (JSX/TSX)",
  "description": "Live in-editor preview of React components with SCSS, comment-based mock data, and Redux support",
  "version": "0.1.0",
  "publisher": "Stenen",
  "icon": "assets/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "keywords": [
    "react",
    "preview",
    "jsx",
    "tsx",
    "scss",
    "css-modules",
    "redux",
    "mock",
    "live-preview",
    "hot-reload"
  ],
  "categories": [
    "Other",
    "Programming Languages",
    "Visualization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Stenen/vscode-component-preview"
  },
  "bugs": {
    "url": "https://github.com/Stenen/vscode-component-preview/issues"
  },
  "homepage": "https://github.com/Stenen/vscode-component-preview#readme",
  "qna": "marketplace",
  "pricing": "Free",
  "activationEvents": [
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onCommand:componentPreview.openPreview",
    "onCommand:componentPreview.debugPreview",
    "onCommand:componentPreview.debugComponent",
    "onCommand:componentPreview.openDevTools",
    "onCommand:componentPreview.stopServer",
    "onCommand:componentPreview.startServer",
    "onCommand:componentPreview.restartServer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "componentPreview.openPreview",
        "title": "Open Component Preview",
        "category": "Component Preview",
        "icon": "$(play)"
      },
      {
        "command": "componentPreview.debugPreview",
        "title": "Debug Component Preview",
        "category": "Component Preview",
        "icon": "$(debug-alt)"
      },
      {
        "command": "componentPreview.debugComponent",
        "title": "Debug Component",
        "category": "Component Preview",
        "icon": "$(debug-alt)"
      },
      {
        "command": "componentPreview.openDevTools",
        "title": "Open Webview Developer Tools",
        "category": "Component Preview",
        "icon": "$(tools)"
      },
      {
        "command": "componentPreview.openComponent",
        "title": "Preview Component",
        "category": "Component Preview"
      },
      {
        "command": "componentPreview.stopServer",
        "title": "Stop Preview Server",
        "category": "Component Preview",
        "icon": "$(debug-stop)"
      },
      {
        "command": "componentPreview.restartServer",
        "title": "Restart Preview Server",
        "category": "Component Preview",
        "icon": "$(debug-restart)"
      },
      {
        "command": "componentPreview.startServer",
        "title": "Start Preview Server",
        "category": "Component Preview",
        "icon": "$(play)"
      },
      {
        "command": "componentPreview.refreshPreview",
        "title": "Refresh Preview",
        "category": "Component Preview",
        "icon": "$(refresh)"
      },
      {
        "command": "componentPreview.openInBrowser",
        "title": "Open Preview in External Browser",
        "category": "Component Preview",
        "icon": "$(globe)"
      },
      {
        "command": "componentPreview.toggleLock",
        "title": "Lock / Unlock Component Preview",
        "category": "Component Preview",
        "icon": "$(lock)"
      }
    ],
    "keybindings": [
      {
        "command": "componentPreview.openPreview",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus && resourceExtname =~ /\\.(jsx|tsx)$/"
      },
      {
        "command": "componentPreview.debugPreview",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorTextFocus && resourceExtname =~ /\\.(jsx|tsx)$/"
      },
      {
        "command": "componentPreview.toggleLock",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l"
      },
      {
        "command": "componentPreview.refreshPreview",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "componentPreview.openPreview",
          "when": "resourceExtname =~ /\\.(jsx|tsx)$/",
          "group": "navigation@1"
        },
        {
          "command": "componentPreview.debugPreview",
          "when": "resourceExtname =~ /\\.(jsx|tsx)$/",
          "group": "navigation@1.5"
        },
        {
          "command": "componentPreview.refreshPreview",
          "when": "resourceExtname =~ /\\.(jsx|tsx)$/",
          "group": "navigation@2"
        },
        {
          "command": "componentPreview.openInBrowser",
          "when": "componentPreview.serverRunning && resourceExtname =~ /\\.(jsx|tsx)$/",
          "group": "navigation@3"
        },
        {
          "command": "componentPreview.toggleLock",
          "when": "resourceExtname =~ /\\.(jsx|tsx)$/",
          "group": "navigation@4"
        },
        {
          "command": "componentPreview.stopServer",
          "when": "componentPreview.serverRunning && resourceExtname =~ /\\.(jsx|tsx)$/",
          "group": "navigation@5"
        },
        {
          "command": "componentPreview.openDevTools",
          "when": "componentPreview.serverRunning && resourceExtname =~ /\\.(jsx|tsx)$/",
          "group": "navigation@6"
        }
      ]
    },
    "configuration": {
      "title": "Component Preview",
      "properties": {
        "componentPreview.port": {
          "type": "number",
          "default": 4545,
          "description": "Port for the background preview server"
        },
        "componentPreview.autoOpenOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically refresh preview when saving JSX/TSX files"
        },
        "componentPreview.stopServerOnClose": {
          "type": "boolean",
          "default": false,
          "description": "Automatically stop the background preview server when the preview panel is closed"
        },
        "componentPreview.lockEditorGroup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically lock the preview editor group so files selected in navigation do not replace the preview"
        },
        "componentPreview.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show interactive CodeLens buttons above React component declarations and @preview comment blocks"
        },
        "componentPreview.theme": {
          "type": "string",
          "enum": ["auto", "dark", "light", "checkerboard"],
          "default": "auto",
          "description": "Default preview canvas theme ('auto' automatically syncs with your active VS Code color theme)"
        },
        "componentPreview.debugBrowser": {
          "type": "string",
          "enum": ["auto", "integrated", "chrome", "edge"],
          "default": "auto",
          "description": "Browser to launch for component debugging sessions ('integrated' uses VS Code's built-in editor-browser without opening external windows; 'auto' selects Chrome or Edge based on availability)"
        },
        "componentPreview.showDebugCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show interactive Debug CodeLens button above React component declarations"
        },
        "componentPreview.debugTarget": {
          "type": "string",
          "enum": ["devtools", "integrated", "browser"],
          "default": "devtools",
          "description": "Default debugger target: 'devtools' opens internal Webview Developer Tools; 'integrated' uses VS Code's editor-browser with in-editor gutter breakpoints and zero external windows; 'browser' launches external Chrome or Edge"
        }
      }
    },
    "debuggers": [
      {
        "type": "componentPreview",
        "label": "Component Preview: Debug Component",
        "languages": ["javascriptreact", "typescriptreact"]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.js --production",
    "watch": "node esbuild.config.js --watch",
    "compile": "tsc -p ./ --noEmit",
    "test": "npx tsx test/testParser.ts && npx tsx test/testNetworkInterceptor.ts && npx tsx test/testViteServer.ts && npx tsx test/testErrorHandling.ts && npx tsx test/testReduxInterceptor.ts && npx tsx test/testConsoleInterceptor.ts && npx tsx test/testVsCodeIntegrations.ts && npx tsx test/testDebuggingIntegration.ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "yaml": "^2.5.1"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "@vitejs/plugin-react": "^4.3.1",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "sass": "^1.78.0",
    "source-map-js": "^1.2.0",
    "vite": "^5.4.3"
  }
}
